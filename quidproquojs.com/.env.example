# Copy to .env and fill in. Only credentials belong here. Everything about a
# deployment (platform, name, environment, feature, account, region, settings)
# lives in apps/<app>/deploy.config.json and is selected with
# `qpq go --app <app> --deployment <name>`; nothing set here overrides it.

# Temporary AWS session credentials (SSO / assumed role) — refresh when expired.
export AWS_ACCESS_KEY_ID=""
export AWS_SECRET_ACCESS_KEY=""
export AWS_SESSION_TOKEN=""
