{
  "name": "quidproquo-dev-server",
  "version": "0.1.17",
  "description": "",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/esm/index.js",
  "types": "./lib/commonjs/index.d.ts",
  "sideEffects": false,
  "files": [
    "lib/**/*",
    "config/**/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "clean": "npx rimraf lib && npx rimraf node_modules",
    "build": "npm run clean && npm run build:esm && npm run build:cjs",
    "watch": "tsc -p tsconfig.commonjs.json -w",
    "build:cjs": "tsc -p tsconfig.commonjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qpqjs/quidproquo.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/qpqjs/quidproquo/issues"
  },
  "homepage": "https://github.com/qpqjs/quidproquo#readme",
  "dependencies": {
    "body-parser": "^1.20.3",
    "chalk": "^4.1.2",
    "chokidar": "^3.6.0",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "quidproquo-actionprocessor-awslambda": "0.1.17",
    "quidproquo-actionprocessor-js": "0.1.17",
    "quidproquo-actionprocessor-node": "0.1.17",
    "quidproquo-core": "0.1.17",
    "quidproquo-webserver": "0.1.17",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/ws": "^8.18.1",
    "quidproquo-tsconfig": "0.1.17",
    "typescript": "^5.8.2"
  }
}