{
  "name": "quidproquo-user-script",
  "version": "0.1.34",
  "description": "Build user-written scripts into one loadable file, on a developer machine, the dev server or lambda",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/esm/index.js",
  "types": "./lib/commonjs/index.d.ts",
  "sideEffects": false,
  "files": [
    "lib/**/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "clean": "npx rimraf lib && npx rimraf node_modules",
    "build": "npm run clean && npm run build:esm && npm run build:cjs",
    "watch": "tsc -p tsconfig.commonjs.json -w",
    "build:cjs": "tsc -p tsconfig.commonjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qpqjs/quidproquo.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/qpqjs/quidproquo/issues"
  },
  "homepage": "https://github.com/qpqjs/quidproquo#readme",
  "dependencies": {
    "@rspack/core": "^2.1.2",
    "quidproquo-actionprocessor-node": "0.1.34",
    "quidproquo-config-aws": "0.1.34",
    "quidproquo-core": "0.1.34"
  },
  "devDependencies": {
    "@types/node": "^22.13.13",
    "quidproquo-actionprocessor-js": "0.1.34",
    "quidproquo-tsconfig": "0.1.34",
    "typescript": "^5.8.2"
  }
}
