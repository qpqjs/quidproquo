{
  "name": "@qpqjs/deploy-rspack",
  "version": "0.4.0",
  "description": "Rspack bundling for quidproquo backends, views and federated remotes.",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/esm/index.js",
  "types": "./lib/commonjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/commonjs/index.d.ts",
      "module": "./lib/esm/index.js",
      "default": "./lib/commonjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "lib/**/*",
    "!lib/**/__fixtures__/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "npx rimraf lib && npx rimraf node_modules",
    "build": "npm run clean && npm run build:esm && npm run build:cjs",
    "watch": "tsc -p tsconfig.esm.json -w",
    "build:cjs": "tsc -p tsconfig.commonjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qpqjs/quidproquo.git",
    "directory": "packages/deploy-rspack"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/qpqjs/quidproquo/issues"
  },
  "homepage": "https://github.com/qpqjs/quidproquo#readme",
  "dependencies": {
    "@module-federation/enhanced": "2.6.0",
    "@module-federation/node": "2.7.52",
    "@rspack/plugin-react-refresh": "^2.0.2",
    "dts-bundle-generator": "9.5.1",
    "path-browserify": "^1.0.1",
    "@qpqjs/actionprocessor-aws": "0.4.0",
    "@qpqjs/config-aws": "0.4.0",
    "@qpqjs/core": "0.4.0",
    "@qpqjs/deploy-aws": "0.4.0",
    "@qpqjs/dev-server": "0.4.0",
    "@qpqjs/webserver": "0.4.0",
    "react-refresh": "^0.18.0"
  },
  "devDependencies": {
    "@qpqjs/testing": "0.4.0",
    "@qpqjs/tsconfig": "0.4.0",
    "@rspack/core": "^2.1.2",
    "@types/node": "^22.13.13",
    "@types/path-browserify": "^1.0.3",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "@rspack/core": "^2.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}