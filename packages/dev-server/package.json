{
  "name": "@qpqjs/dev-server",
  "version": "0.3.0",
  "description": "A local server that runs a whole quidproquo app on one machine.",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/esm/index.js",
  "types": "./lib/commonjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/commonjs/index.d.ts",
      "module": "./lib/esm/index.js",
      "default": "./lib/commonjs/index.js"
    },
    "./config": {
      "types": "./lib/commonjs/config/index.d.ts",
      "module": "./lib/esm/config/index.js",
      "default": "./lib/commonjs/config/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "lib/**/*",
    "config/**/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "npx rimraf lib && npx rimraf node_modules",
    "build": "npm run clean && npm run build:esm && npm run build:cjs",
    "watch": "tsc -p tsconfig.commonjs.json -w",
    "build:cjs": "tsc -p tsconfig.commonjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qpqjs/quidproquo.git",
    "directory": "packages/dev-server"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/qpqjs/quidproquo/issues"
  },
  "homepage": "https://github.com/qpqjs/quidproquo#readme",
  "dependencies": {
    "body-parser": "^1.20.3",
    "chalk": "^4.1.2",
    "chokidar": "^3.6.0",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "@qpqjs/actionprocessor-aws": "0.3.0",
    "@qpqjs/actionprocessor-js": "0.3.0",
    "@qpqjs/actionprocessor-node": "0.3.0",
    "@qpqjs/config-aws": "0.3.0",
    "@qpqjs/core": "0.3.0",
    "@qpqjs/webserver": "0.3.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/ws": "^8.18.1",
    "@qpqjs/tsconfig": "0.3.0",
    "typescript": "^5.8.2"
  }
}
