{
  "compilerOptions": {
    // Determines the module system, "node" works well in a Node.js environment
    "moduleResolution": "node",
    
    // Enables compatibility with ES6 module imports
    "esModuleInterop": true,
    
    // Sets the JavaScript language target to ES6
    "target": "ES6",
    
    // Includes type definitions for ES2021 features and DOM APIs
    "lib": ["es2021", "dom"],
    
    // Allows default imports from modules with no default export
    "allowSyntheticDefaultImports": true,

    // Enables all strict type checking options (noImplicitAny, strictNullChecks, alwaysStrict and the rest)
    "strict": true,

    // Indexing an array or record yields `T | undefined`; overriding a base member needs the keyword
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Dependencies ship their own checked declarations
    "skipLibCheck": true,

    // Report error when not all code paths return in function
    "noImplicitReturns": true,

    // Report fallthrough cases in switch statement
    "noFallthroughCasesInSwitch": true,

    // Enforce consistent casing in file names
    "forceConsistentCasingInFileNames": true,

    // Do not emit output (JavaScript files)
    "noEmit": false,

    // Emit '.map' files with the original TS embedded (inlineSources), so consumers of
    // the built output never need the src files: this is what lets the federated remote
    // build chain framework code back to TS in execution traces.
    "sourceMap": true,
    "inlineSources": true,

    // Allows importing JSON files
    "resolveJsonModule": true,

    // Allows compiling JavaScript files
    "allowJs": true,

    // Generates a .d.ts file for the TypeScript files
    "declaration": true,

    // allow dot notation when accessing properties defined using an index signature
    "noPropertyAccessFromIndexSignature": false

  },  
  
  // Exclude the node_modules directory to improve performance
  "exclude": ["node_modules"]
}
