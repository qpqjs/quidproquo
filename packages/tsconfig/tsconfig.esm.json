// tsconfig.esm.json
// The ESM half of a package build. `${configDir}` is the extending package's folder, so every package
// compiles `src` into `lib/esm` and leaves tests, fixtures and test helpers out without restating the list.
{
  "extends": "./tsconfig.base",
  "compilerOptions": {
    "module": "ESNext",
    "target": "ESNext",
    "outDir": "${configDir}/lib/esm"
  },
  "include": ["${configDir}/src"],
  "exclude": [
    "${configDir}/node_modules",
    "${configDir}/**/*.test.ts",
    "${configDir}/**/*.test.tsx",
    "${configDir}/**/__fixtures__/**",
    "${configDir}/**/testing/**"
  ]
}
