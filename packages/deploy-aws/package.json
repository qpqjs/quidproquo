{
  "name": "@qpqjs/deploy-aws",
  "version": "0.3.0",
  "description": "CDK constructs and stacks that deploy a quidproquo app to AWS.",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/esm/index.js",
  "types": "./lib/commonjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/commonjs/index.d.ts",
      "module": "./lib/esm/index.js",
      "default": "./lib/commonjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "lib/**/*",
    "src/**/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "npx rimraf lib && npx rimraf node_modules",
    "build": "npm run clean && npm run build:esm && npm run build:cjs",
    "watch": "tsc -p tsconfig.commonjs.json -w",
    "build:cjs": "tsc -p tsconfig.commonjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qpqjs/quidproquo.git",
    "directory": "packages/deploy-aws"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/qpqjs/quidproquo/issues"
  },
  "homepage": "https://github.com/qpqjs/quidproquo#readme",
  "dependencies": {
    "@aws-cdk/aws-neptune-alpha": "^2.262.0-alpha.0",
    "@qpqjs/actionprocessor-aws": "0.3.0",
    "@qpqjs/config-aws": "0.3.0",
    "@qpqjs/core": "0.3.0",
    "@qpqjs/webserver": "0.3.0",
    "aws-cdk-lib": "^2.275.0",
    "constructs": "^10.7.1",
    "upath": "^2.0.1"
  },
  "devDependencies": {
    "@qpqjs/tsconfig": "0.3.0",
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^22.13.13",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=24"
  }
}
