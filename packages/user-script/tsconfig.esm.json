{
  "extends": "@qpqjs/tsconfig/tsconfig.esm.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "outDir": "./lib/esm",
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/__fixtures__/**"
  ]
}
