{
  "name": "@qpqjs/testing",
  "version": "0.4.0",
  "description": "Test helpers for quidproquo stories, requesters and config.",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/esm/index.js",
  "types": "./lib/commonjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/commonjs/index.d.ts",
      "module": "./lib/esm/index.js",
      "default": "./lib/commonjs/index.js"
    },
    "./vitest": {
      "types": "./lib/commonjs/vitest.d.ts",
      "module": "./lib/esm/vitest.js",
      "default": "./lib/commonjs/vitest.js"
    },
    "./vitest-config": {
      "types": "./lib/commonjs/vitestConfig/index.d.ts",
      "module": "./lib/esm/vitestConfig/index.js",
      "default": "./lib/commonjs/vitestConfig/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "lib/**/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "npx rimraf lib && npx rimraf node_modules",
    "build": "npm run clean && npm run build:esm && npm run build:cjs",
    "watch": "tsc -p tsconfig.esm.json -w",
    "build:cjs": "tsc -p tsconfig.commonjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qpqjs/quidproquo.git",
    "directory": "packages/testing"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/qpqjs/quidproquo/issues"
  },
  "homepage": "https://github.com/qpqjs/quidproquo#readme",
  "dependencies": {
    "@qpqjs/core": "0.4.0"
  },
  "devDependencies": {
    "@qpqjs/tsconfig": "0.4.0",
    "typescript": "^5.8.2",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "vitest": ">=0.34.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}