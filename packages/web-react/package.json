{
  "name": "@qpqjs/web-react",
  "version": "0.3.0",
  "description": "React bindings for quidproquo: runtimes, stores and hooks.",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/esm/index.js",
  "types": "./lib/commonjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/commonjs/index.d.ts",
      "module": "./lib/esm/index.js",
      "default": "./lib/commonjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "lib/**/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "npx rimraf lib && npx rimraf node_modules",
    "build": "npm run clean && npm run build:esm && npm run build:cjs",
    "watch": "tsc -p tsconfig.esm.json -w",
    "build:cjs": "tsc -p tsconfig.commonjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qpqjs/quidproquo.git",
    "directory": "packages/web-react"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/qpqjs/quidproquo/issues"
  },
  "homepage": "https://github.com/qpqjs/quidproquo#readme",
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@qpqjs/tsconfig": "0.3.0",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "react": ">=18.3.1"
  },
  "dependencies": {
    "@qpqjs/actionprocessor-web": "0.3.0",
    "@qpqjs/core": "0.3.0",
    "@qpqjs/features": "0.3.0",
    "@qpqjs/web": "0.3.0",
    "@qpqjs/webserver": "0.3.0",
    "symbol-observable": "^4.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
