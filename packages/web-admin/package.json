{
  "name": "@qpqjs/web-admin",
  "version": "0.3.0",
  "description": "The admin UI for a quidproquo app: logs, traces, config and maintenance.",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/esm/index.js",
  "types": "./lib/commonjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/commonjs/index.d.ts",
      "module": "./lib/esm/index.js",
      "default": "./lib/commonjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "lib/**/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "npx rimraf lib && npx rimraf node_modules",
    "build": "npm run clean && npm run build:esm && npm run build:cjs",
    "watch": "tsc -p tsconfig.esm.json -w",
    "build:cjs": "tsc -p tsconfig.commonjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qpqjs/quidproquo.git",
    "directory": "packages/web-admin"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/qpqjs/quidproquo/issues"
  },
  "homepage": "https://github.com/qpqjs/quidproquo#readme",
  "dependencies": {
    "@emotion/react": "^11.10.8",
    "@emotion/styled": "^11.10.8",
    "@mui/icons-material": "^5.11.16",
    "@mui/material": "^5.12.2",
    "@mui/x-data-grid": "^6.3.0",
    "@mui/x-date-pickers": "^6.3.0",
    "@qpqjs/core": "0.3.0",
    "@qpqjs/features": "0.3.0",
    "@qpqjs/web": "0.3.0",
    "@qpqjs/web-react": "0.3.0",
    "@qpqjs/webserver": "0.3.0",
    "date-fns": "^2.30.0",
    "javascript-time-ago": "^2.5.9",
    "react-d3-tree": "^3.6.6",
    "react-dom": "18.3.1",
    "react-inspector": "^6.0.2",
    "react-markdown": "^9.0.1",
    "react-time-ago": "^7.2.1",
    "recharts": "^2.12.3"
  },
  "devDependencies": {
    "@qpqjs/testing": "0.3.0",
    "@qpqjs/tsconfig": "0.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.13.13",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "react": ">=18.3.1"
  },
  "engines": {
    "node": ">=24"
  }
}
