{
  "name": "quidproquo-testing",
  "version": "0.1.19",
  "description": "",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/esm/index.js",
  "types": "./lib/esm/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./lib/esm/index.d.ts",
      "import": "./lib/esm/index.js",
      "require": "./lib/commonjs/index.js"
    },
    "./vitest": {
      "types": "./lib/esm/vitest.d.ts",
      "import": "./lib/esm/vitest.js",
      "require": "./lib/commonjs/vitest.js"
    }
  },
  "files": [
    "lib/**/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "npx rimraf lib && npx rimraf node_modules",
    "build": "npm run clean && npm run build:esm && npm run build:cjs",
    "watch": "tsc -p tsconfig.esm.json -w",
    "build:cjs": "tsc -p tsconfig.commonjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qpqjs/quidproquo.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/qpqjs/quidproquo/issues"
  },
  "homepage": "https://github.com/qpqjs/quidproquo#readme",
  "devDependencies": {
    "quidproquo-tsconfig": "0.1.19",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "vitest": ">=0.34.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}